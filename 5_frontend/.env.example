# Copy to `.env` for local `npm start` (never commit `.env`).
# CRA bakes REACT_APP_* into the bundle at build/start time — restart after edits.

# Public Mapbox token (pk.) — restrict URL origins in the Mapbox dashboard.
REACT_APP_MAPBOX_TOKEN=

# Optional local overrides (normally set by `start.js` flags instead):
# REACT_APP_UI_VERSION=v2
# REACT_APP_FORCE_MODE=day
# REACT_APP_MOBILE_DEBUG=1

# Production / nginx same-origin API prefix (used at `npm run build` time):
# REACT_APP_API_BASE=/api
#
# Local default when unset: http://127.0.0.1:5000
# With `npm start -- --mobile`: http://<LAN-IP>:5000 (via REACT_APP_MOBILE_DEBUG)
